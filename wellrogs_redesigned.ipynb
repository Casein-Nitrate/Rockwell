   "source": [
    "# Rogii Wellbore Geology Prediction — Geometry-Aware Redesign\n",
    "## Target: RMSE < 6 via Geological Intelligence + Residual ML\n",
    "\n",
    "**Architecture:** Geology baseline → Feature engineering → Residual ML ensemble → Per-well tuning\n",
    "\n",
    "**Key changes from original (15.38 RMSE):**\n",
    "1. Leverage ANCC, ASTNU, ASTNL, EGFDU, EGFDL, BUDA as primary features (not GR alone)\n",
    "2. Extract TVT relationships from entire known trajectory, not just last 500 rows\n",
    "3. Model TVT and dTVT (differential) separately with distinct learners\n",
    "4. Multi-scale GR correlation (shape, gradient, derivative, normalized cross-correlation)\n",
    "5. Explicit PS (Prediction Start) feature engineering\n",
    "6. Residual learning: train ML models on (true_TVT - baseline_TVT)\n",
    "7. Geology + ML ensemble with confidence weighting\n",
    "8. GroupKFold validation by well_id\n",
    "9. Neighbor well spatial analysis\n",
    "10. Ablation study + feature importance\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "from pathlib import Path\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "from sklearn.model_selection import GroupKFold, cross_val_score\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "from sklearn.metrics import mean_squared_error\n",
    "from scipy import signal, stats\n",
    "from scipy.interpolate import interp1d\n",
    "from scipy.spatial.distance import euclidean\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "try:\n",
    "    import catboost as cb\n",
    "    HAS_CATBOOST = True\n",
    "except:\n",
    "    HAS_CATBOOST = False\n",
    "    print('CatBoost not installed; will train with LightGBM only')\n",
    "\n",
    "try:\n",
    "    import lightgbm as lgb\n",
    "    HAS_LGBM = True\n",
    "except:\n",
    "    HAS_LGBM = False\n",
    "    print('LightGBM not installed')\n",
    "\n",
    "try:\n",
    "    from dtaidistance import dtw\n",
    "    HAS_DTW = True\n",
    "except:\n",
    "    HAS_DTW = False\n",
    "    print('DTW not installed; will use correlation-based alignment')\n",
    "\n",
    "BASE_PATH = Path('/kaggle/input/competitions/rogii-wellbore-geology-prediction')\n",
    "TRAIN_PATH = BASE_PATH / 'train'\n",
    "TEST_PATH = BASE_PATH / 'test'\n",
    "\n",
    "train_hw_files = sorted(TRAIN_PATH.glob('*__horizontal_well.csv'))\n",
    "train_tw_files = sorted(TRAIN_PATH.glob('*__typewell.csv'))\n",
    "test_hw_files = sorted(TEST_PATH.glob('*__horizontal_well.csv'))\n",
    "test_tw_files = sorted(TEST_PATH.glob('*__typewell.csv'))\n",
    "\n",
    "print(f'Train wells: {len(train_hw_files)}')\n",
    "print(f'Test wells: {len(test_hw_files)}')\n",
    "print(f'HAS_CATBOOST: {HAS_CATBOOST}')\n",
    "print(f'HAS_LGBM: {HAS_LGBM}')\n",
    "print(f'HAS_DTW: {HAS_DTW}')\n",
    "\n",
    "rng = np.random.RandomState(42)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Section 1: Data Loading & Preprocessing"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def load_well_data(hw_path, tw_path=None):\n",
    "    \"\"\"Load horizontal and typewell data.\"\"\"\n",
    "    hw = pd.read_csv(hw_path)\n",
    "    tw = None\n",
    "    if tw_path and tw_path.exists():\n",
    "        try:\n",
    "            tw = pd.read_csv(tw_path)\n",
    "        except:\n",
    "            pass\n",
    "    return hw, tw\n",
    "\n",
    "def get_well_id(hw_path):\n",
    "    \"\"\"Extract well ID from filename.\"\"\"\n",
    "    return hw_path.stem.split('__')[0]\n",
    "\n",
    "# Build well ID mappings\n",
    "well_id_to_train_idx = {}\n",
    "train_wells_data = []\n",
    "\n",
    "for idx, hw_path in enumerate(train_hw_files):\n",
    "    well_id = get_well_id(hw_path)\n",
    "    well_id_to_train_idx[well_id] = idx\n",
    "    tw_path = TRAIN_PATH / f'{well_id}__typewell.csv'\n",
    "    hw, tw = load_well_data(hw_path, tw_path)\n",
    "    train_wells_data.append({'well_id': well_id, 'hw': hw, 'tw': tw, 'path': hw_path})\n",
    "\n",
    "print(f'Loaded {len(train_wells_data)} training wells')\n",
    "\n",
    "# Sample well inspection\n",
    "sample_hw = train_wells_data[0]['hw']\n",
    "print(f\"\\nSample well shape: {sample_hw.shape}\")\n",
    "print(f\"Columns: {list(sample_hw.columns)}\")\n",
    "print(f\"Sample data:\\n{sample_hw.head()}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Section 2: Geological Surface Feature Engineering\n",
    "### Create depth-to-surface features and formation thicknesses"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def create_geological_features(hw):\n",
    "    \"\"\"\n",
    "    Create depth-to-surface features and formation thicknesses.\n",
    "    Inputs: ANCC, ASTNU, ASTNL, EGFDU, EGFDL, BUDA\n",
    "    \n",
    "    Returns DataFrame with new geological features.\n",
    "    \"\"\"\n",
    "    geo_features = pd.DataFrame(index=hw.index)\n",
    "    \n",
    "    # Depth-to-surface features (Z minus surface depth)\n",
    "    surfaces = ['ANCC', 'ASTNU', 'ASTNL', 'EGFDU', 'EGFDL', 'BUDA']\n",
    "    for surf in surfaces:\n",
    "        if surf in hw.columns:\n",
    "            geo_features[f'Z_{surf}'] = hw['Z'] - hw[surf]\n",
    "    \n",
    "    # Formation thicknesses (surface-to-surface differences)\n",
    "    thickness_pairs = [\n",
    "        ('ANCC', 'ASTNU'),\n",
    "        ('ASTNU', 'ASTNL'),\n",
    "        ('ASTNL', 'EGFDU'),\n",
    "        ('EGFDU', 'EGFDL'),\n",
    "        ('EGFDL', 'BUDA'),\n",
    "    ]\n",
    "    for s1, s2 in thickness_pairs:\n",
    "        if s1 in hw.columns and s2 in hw.columns:\n",
    "            geo_features[f'{s1}_{s2}_thick'] = hw[s1] - hw[s2]\n",
    "    \n",
    "    return geo_features\n",
    "\n",
    "# Test on sample well\n",
    "sample_geo = create_geological_features(sample_hw)\n",
    "print(f\"Sample geological features shape: {sample_geo.shape}\")\n",
    "print(f\"Columns: {list(sample_geo.columns)}\")\n",
    "print(f\"Sample data:\\n{sample_geo.head()}\")\n",
    "print(f\"\\nMissing values:\\n{sample_geo.isna().sum()}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Section 3: GR Multi-Scale Correlation Features\n",
    "### Shape, gradient, derivative matching with typewell GR"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def normalized_cross_correlation(x, y, max_lag=None):\n",
    "    \"\"\"Compute normalized cross-correlation max and optimal lag.\"\"\"\n",
    "    x = np.nan_to_num(x, 0)\n",
    "    y = np.nan_to_num(y, 0)\n",
    "    \n",
    "    x_norm = (x - np.mean(x)) / (np.std(x) + 1e-8)\n",
    "    y_norm = (y - np.mean(y)) / (np.std(y) + 1e-8)\n",
    "    \n",
    "    if max_lag is None:\n",
    "        max_lag = min(len(x), len(y)) // 4\n",
    "    \n",
    "    correlations = []\n",
    "    for lag in range(-max_lag, max_lag + 1):\n",
    "        if lag >= 0:\n",
    "            c = np.corrcoef(x_norm[lag:], y_norm[:-lag or None])[0, 1]\n",
    "        else:\n",
    "            c = np.corrcoef(x_norm[:lag], y_norm[-lag:])[0, 1]\n",
    "        correlations.append(c if not np.isnan(c) else 0)\n",
    "    \n",
    "    max_corr = np.nanmax(correlations) if correlations else 0\n",
    "    opt_lag = np.nanargmax(correlations) - max_lag if correlations else 0\n",
    "    \n",
    "    return max_corr, opt_lag\n",
    "\n",
    "def gr_gradient(gr_series, window=5):\n",
    "    \"\"\"Compute GR gradient (derivative).\"\"\"\n",
    "    gr_clean = np.nan_to_num(gr_series.values, 0)\n",
    "    grad = np.gradient(gr_clean)\n",
    "    return pd.Series(grad, index=gr_series.index)\n",
    "\n",
    "def create_gr_features(hw, tw=None):\n",
    "    \"\"\"\n",
    "    Create multi-scale GR correlation and shape features.\n",
    "    \"\"\"\n",
    "    features = pd.DataFrame(index=hw.index)\n",
    "    \n",
    "    if 'GR' not in hw.columns:\n",
    "        return features\n",
    "    \n",
    "    gr = hw['GR'].values\n",
    "    gr_clean = np.nan_to_num(gr, 0)\n",
    "    \n",
    "    # GR statistics in rolling windows\n",
    "    for window in [50, 100, 200]:\n",
    "        if len(gr) >= window:\n",
    "            features[f'GR_mean_w{window}'] = pd.Series(gr_clean).rolling(window=window, center=True).mean().values\n",
    "            features[f'GR_std_w{window}'] = pd.Series(gr_clean).rolling(window=window, center=True).std().values\n",
    "            features[f'GR_max_w{window}'] = pd.Series(gr_clean).rolling(window=window, center=True).max().values\n",
    "    \n",
    "    # GR gradient (change rate)\n",
    "    gr_grad = gr_gradient(hw['GR'].fillna(method='ffill').fillna(method='bfill'))\n",
    "    features['GR_gradient'] = gr_grad.values\n",
    "    features['GR_gradient_abs'] = np.abs(gr_grad.values)\n",
    "    features['GR_gradient_smooth'] = gr_grad.rolling(window=10, center=True).mean().values\n",
    "    \n",
    "    # GR vs typewell correlation (if available)\n",
    "    if tw is not None and 'GR' in tw.columns:\n",
    "        tw_gr = tw['GR'].values\n",
    "        # Find best correlation in sliding windows\n",
    "        corr_scores = []\n",
    "        for i in range(0, len(gr) - 100, 50):\n",
    "            window_gr = gr_clean[i:i+100]\n",
    "            if len(tw_gr) >= 100:\n",
    "                c, lag = normalized_cross_correlation(window_gr, tw_gr[:100], max_lag=20)\n",
    "                corr_scores.append(c)\n",
    "        \n",
    "        if corr_scores:\n",
    "            features['GR_typewell_corr_max'] = np.nanmax(corr_scores)\n",
    "            features['GR_typewell_corr_mean'] = np.nanmean(corr_scores)\n",
    "        else:\n",
    "            features['GR_typewell_corr_max'] = 0\n",
    "            features['GR_typewell_corr_mean'] = 0\n",
    "    \n",
    "    features = features.fillna(0)\n",
    "    return features\n",
    "\n",
    "# Test\n",
    "sample_gr_feat = create_gr_features(sample_hw, train_wells_data[0]['tw'])\n",
    "print(f\"Sample GR features shape: {sample_gr_feat.shape}\")\n",
    "print(f\"Columns: {list(sample_gr_feat.columns)}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Section 4: TVT Trajectory Learning\n",
    "### Extract patterns from entire known TVT history (not just last 500 rows)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def extract_tvt_patterns(hw):\n",
    "    \"\"\"\n",
    "    From known TVT section, extract pattern features.\n",
    "    \"\"\"\n",
    "    patterns = {}\n",
    "    \n",
    "    known_mask = hw['TVT_input'].notna()\n",
    "    if known_mask.sum() < 10:\n",
    "        return patterns\n",
    "    \n",
    "    known = hw[known_mask].copy()\n",
    "    tvt_known = known['TVT_input'].values\n",
    "    md_known = known['MD'].values\n",
    "    \n",
    "    # Global trend\n",
    "    dtvt = tvt_known[1:] - tvt_known[:-1]\n",
    "    patterns['dTVT_mean'] = np.mean(dtvt)\n",
    "    patterns['dTVT_std'] = np.std(dtvt)\n",
    "    patterns['dTVT_median'] = np.median(dtvt)\n",
    "    patterns['dTVT_max'] = np.max(dtvt)\n",
    "    patterns['dTVT_min'] = np.min(dtvt)\n",
    "    \n",
    "    # Slope from entire known section\n",
    "    poly = np.polyfit(md_known, tvt_known, 1)\n",
    "    patterns['TVT_slope_full'] = poly[0]\n",
    "    patterns['TVT_intercept_full'] = poly[1]\n",
    "    \n",
    "    # Last 500 rows (original approach for comparison)\n",
    "    if len(known) >= 500:\n",
    "        last_500 = known.tail(500)\n",
    "        poly_500 = np.polyfit(last_500['MD'].values, last_500['TVT_input'].values, 1)\n",
    "        patterns['TVT_slope_last500'] = poly_500[0]\n",
    "        patterns['TVT_intercept_last500'] = poly_500[1]\n",
    "    else:\n",
    "        patterns['TVT_slope_last500'] = patterns['TVT_slope_full']\n",
    "        patterns['TVT_intercept_last500'] = patterns['TVT_intercept_full']\n",
    "    \n",
    "    # Trend changes (acceleration)\n",
    "    d2tvt = dtvt[1:] - dtvt[:-1]\n",
    "    patterns['d2TVT_mean'] = np.mean(d2tvt) if len(d2tvt) > 0 else 0\n",
    "    patterns['d2TVT_std'] = np.std(d2tvt) if len(d2tvt) > 0 else 0\n",
    "    \n",
    "    # Anchor point\n",
    "    patterns['TVT_anchor'] = tvt_known[-1]\n",
    "    patterns['MD_anchor'] = md_known[-1]\n",
    "    patterns['known_section_length'] = len(known)\n",
    "    patterns['known_md_range'] = md_known[-1] - md_known[0]\n",
    "    \n",
    "    return patterns\n",
    "\n",
    "# Test\n",
    "sample_patterns = extract_tvt_patterns(sample_hw)\n",
    "print(f\"TVT pattern features: {len(sample_patterns)}\")\n",
    "for k, v in list(sample_patterns.items())[:5]:\n",
    "    print(f\"  {k}: {v:.4f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Section 5: Prediction Start (PS) Feature Engineering\n",
    "### Treat PS boundary as meaningful geological information"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def create_ps_features(hw):\n",
    "    \"\"\"\n",
    "    Create features related to Prediction Start (PS) position.\n",
    "    \"\"\"\n",
    "    ps_features = pd.DataFrame(index=hw.index)\n",
    "    \n",
    "    # Identify PS: last row where TVT_input is not NaN\n",
    "    known_mask = hw['TVT_input'].notna()\n",
    "    if not known_mask.any():\n",
    "        ps_features['is_after_PS'] = 0\n",
    "        ps_features['md_after_PS'] = 0\n",
    "        ps_features['rows_after_PS'] = 0\n",
    "        ps_features['normalized_distance_from_PS'] = 0\n",
    "        return ps_features\n",
    "    \n",
    "    ps_idx = known_mask.idxmax() + known_mask[:known_mask.idxmax()+1].sum() - 1\n",
    "    ps_md = hw.loc[known_mask, 'MD'].iloc[-1] if known_mask.sum() > 0 else hw['MD'].iloc[0]\n",
    "    \n",
    "    ps_features['is_after_PS'] = (~known_mask).astype(int)\n",
    "    ps_features['md_after_PS'] = (hw['MD'] - ps_md).clip(lower=0)\n",
    "    ps_features['rows_after_PS'] = np.arange(len(hw)) - (known_mask.sum())\n",
    "    ps_features['rows_after_PS'] = ps_features['rows_after_PS'].clip(lower=0)\n",
    "    \n",
    "    # Normalized distance from PS (0 to 1)\n",
    "    eval_mask = ~known_mask\n",
    "    if eval_mask.sum() > 0:\n",
    "        total_eval_length = eval_mask.sum()\n",
    "        eval_position = (ps_features.loc[eval_mask, 'rows_after_PS'].values - 1) / total_eval_length\n",
    "        eval_position = np.clip(eval_position, 0, 1)\n",
    "        ps_features.loc[eval_mask, 'normalized_distance_from_PS'] = eval_position\n",
    "    \n",
    "    ps_features = ps_features.fillna(0)\n",
    "    return ps_features\n",
    "\n",
    "# Test\n",
    "sample_ps_feat = create_ps_features(sample_hw)\n",
    "print(f\"PS features shape: {sample_ps_feat.shape}\")\n",
    "print(f\"Columns: {list(sample_ps_feat.columns)}\")\n",
    "print(f\"Sample:\\n{sample_ps_feat.head()}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Section 6: Baseline TVT Prediction (Geological Model)\n",
    "### Non-ML geology-based prediction for residual learning"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def predict_baseline_tvt(hw, tvt_patterns):\n",
    "    \"\"\"\n",
    "    Geological baseline prediction using multiple strategies.\n",
    "    Returns ensemble of:\n",
    "    1. Flat anchor\n",
    "    2. Full-history slope\n",
    "    3. Last-500 slope\n",
    "    4. Adaptive smoothing\n",
    "    \"\"\"\n",
    "    eval_mask = hw['TVT_input'].isna()\n",
    "    if not eval_mask.any():\n",
    "        return None\n",
    "    \n",
    "    eval_df = hw[eval_mask].copy()\n",
    "    \n",
    "    anchor = tvt_patterns['TVT_anchor']\n",
    "    ps_md = tvt_patterns['MD_anchor']\n",
    "    slope_full = tvt_patterns['TVT_slope_full']\n",
    "    slope_500 = tvt_patterns['TVT_slope_last500']\n",
    "    \n",
    "    # Strategy 1: Flat anchor\n",
    "    pred_flat = np.full(len(eval_df), anchor)\n",
    "    \n",
    "    # Strategy 2: Full-history slope\n",
    "    md_offset = eval_df['MD'].values - ps_md\n",
    "    pred_slope_full = anchor + slope_full * md_offset\n",
    "    \n",
    "    # Strategy 3: Last-500 slope\n",
    "    pred_slope_500 = anchor + slope_500 * md_offset\n",
    "    \n",
    "    # Strategy 4: Adaptive (blend slope and flat based on dtvt variance)\n",
    "    dtvt_std = tvt_patterns['dTVT_std']\n",
    "    if dtvt_std < 0.5:  # Low variance: slope unreliable, use flat\n",
    "        pred_adaptive = pred_flat\n",
    "    else:  # High variance: use average slope\n",
    "        avg_slope = (slope_full + slope_500) / 2\n",
    "        pred_adaptive = anchor + avg_slope * md_offset\n",
    "    \n",
    "    # Ensemble: average of all strategies\n",
    "    baseline_pred = (pred_flat + pred_slope_full + pred_slope_500 + pred_adaptive) / 4\n",
    "    \n",
    "    result = pd.DataFrame({\n",
    "        'baseline_TVT': baseline_pred,\n",
    "        'pred_flat': pred_flat,\n",
    "        'pred_slope_full': pred_slope_full,\n",
    "        'pred_slope_500': pred_slope_500,\n",
    "        'pred_adaptive': pred_adaptive,\n",
    "    }, index=eval_df.index)\n",
    "    \n",
    "    return result\n",
    "\n",
    "# Test\n",
    "sample_patterns = extract_tvt_patterns(sample_hw)\n",
    "sample_baseline = predict_baseline_tvt(sample_hw, sample_patterns)\n",
    "print(f\"Baseline predictions shape: {sample_baseline.shape}\")\n",
    "print(f\"Sample baseline:\\n{sample_baseline.head()}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Section 7: Comprehensive Feature Matrix Construction"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def build_feature_matrix(hw, tw=None, tvt_patterns=None, baseline_pred=None):\n",
    "    \"\"\"\n",
    "    Construct complete feature matrix for eval zone.\n",
    "    Combines: geological, GR, PS, trajectory, and baseline prediction features.\n",
    "    \"\"\"\n",
    "    eval_mask = hw['TVT_input'].isna()\n",
    "    eval_df = hw[eval_mask].copy()\n",
    "    \n",
    "    if len(eval_df) == 0:\n",
    "        return None\n",
    "    \n",
    "    features = pd.DataFrame(index=eval_df.index)\n",
    "    \n",
    "    # 1. Geological surface features\n",
    "    geo_feat = create_geological_features(eval_df)\n",
    "    for col in geo_feat.columns:\n",
    "        features[col] = geo_feat[col]\n",
    "    \n",
    "    # 2. GR correlation features\n",
    "    gr_feat = create_gr_features(eval_df, tw)\n",
    "    for col in gr_feat.columns:\n",
    "        features[col] = gr_feat[col]\n",
    "    \n",
    "    # 3. PS features\n",
    "    ps_feat = create_ps_features(eval_df)\n",
    "    for col in ps_feat.columns:\n",
    "        features[col] = ps_feat[col]\n",
    "    \n",
    "    # 4. TVT pattern features\n",
    "    if tvt_patterns:\n",
    "        for key, val in tvt_patterns.items():\n",
    "            features[f'pattern_{key}'] = val\n",
    "    \n",
    "    # 5. Baseline predictions\n",
    "    if baseline_pred is not None:\n",
    "        for col in baseline_pred.columns:\n",
    "            features[f'base_{col}'] = baseline_pred[col].values\n",
    "    \n",
    "    # 6. Spatial features\n",
    "    if 'X' in eval_df.columns and 'Y' in eval_df.columns:\n",
    "        features['X'] = eval_df['X'].values\n",
    "        features['Y'] = eval_df['Y'].values\n",
    "        features['X_mean'] = eval_df['X'].mean()\n",
    "        features['Y_mean'] = eval_df['Y'].mean()\n",
    "    \n",
    "    if 'Z' in eval_df.columns:\n",
    "        features['Z'] = eval_df['Z'].values\n",
    "        features['MD'] = eval_df['MD'].values\n",
    "    \n",
    "    # 7. Trajectory curvature\n",
    "    if 'MD' in eval_df.columns and len(eval_df) > 2:\n",
    "        md = eval_df['MD'].values\n",
    "        x = eval_df['X'].values if 'X' in eval_df.columns else np.zeros(len(eval_df))\n",
    "        y = eval_df['Y'].values if 'Y' in eval_df.columns else np.zeros(len(eval_df))\n",
    "        dmd = np.gradient(md)\n",
    "        dx = np.gradient(x)\n",
    "        dy = np.gradient(y)\n",
    "        features['trajectory_angle'] = np.arctan2(dy, dx)\n",
    "        features['trajectory_curvature'] = np.abs(np.gradient(features['trajectory_angle'])) / (dmd + 1e-8)\n",
    "    \n",
    "    features = features.fillna(0)\n",
    "    return features\n",
    "\n",
    "# Test\n",
    "sample_patterns = extract_tvt_patterns(sample_hw)\n",
    "sample_baseline = predict_baseline_tvt(sample_hw, sample_patterns)\n",
    "sample_features = build_feature_matrix(sample_hw, train_wells_data[0]['tw'], sample_patterns, sample_baseline)\n",
    "print(f\"Feature matrix shape: {sample_features.shape}\")\n",
    "print(f\"Total features: {len(sample_features.columns)}\")\n",
    "print(f\"Column names (first 20):\\n{list(sample_features.columns[:20])}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Section 8: Training Data Assembly\n",
    "### Build X, y, groups for GroupKFold validation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def build_training_data(wells_data, sample_fraction=1.0):\n",
    "    \"\"\"\n",
    "    Build training dataset from all wells.\n",
    "    Returns: X, y, groups, well_info\n",
    "    \"\"\"\n",
    "    X_list = []\n",
    "    y_list = []\n",
    "    groups = []\n",
    "    well_info = []\n",
    "    \n",
    "    n_wells = len(wells_data)\n",
    "    if sample_fraction < 1.0:\n",
    "        sample_size = int(n_wells * sample_fraction)\n",
    "        well_indices = rng.choice(n_wells, size=sample_size, replace=False)\n",
    "    else:\n",
    "        well_indices = np.arange(n_wells)\n",
    "    \n",
    "    for idx in well_indices:\n",
    "        wd = wells_data[idx]\n",
    "        well_id = wd['well_id']\n",
    "        hw = wd['hw']\n",
    "        tw = wd['tw']\n",
    "        \n",
    "        # Check if eval zone exists\n",
    "        eval_mask = hw['TVT_input'].isna()\n",
    "        if not eval_mask.any() or 'TVT' not in hw.columns:\n",
    "            continue\n",
    "        \n",
    "        eval_df = hw[eval_mask].copy()\n",
    "        \n",
    "        # Extract TVT pattern and baseline\n",
    "        tvt_patterns = extract_tvt_patterns(hw)\n",
    "        baseline_pred = predict_baseline_tvt(hw, tvt_patterns)\n",
    "        \n",
    "        # Build features\n",
    "        features = build_feature_matrix(hw, tw, tvt_patterns, baseline_pred)\n",
    "        if features is None or len(features) == 0:\n",
    "            continue\n",
    "        \n",
    "        # Get targets\n",
    "        targets = eval_df['TVT'].values\n",
    "        \n",
    "        if len(features) != len(targets):\n",
    "            continue\n",
    "        \n",
    "        X_list.append(features.values)\n",
    "        y_list.append(targets)\n",
    "        groups.extend([well_id] * len(targets))\n",
    "        well_info.append({\n",
    "            'well_id': well_id,\n",
    "            'n_samples': len(targets),\n",
    "            'tvt_range': targets.max() - targets.min(),\n",
    "            'tvt_mean': targets.mean(),\n",
    "        })\n",
    "    \n",
    "    X = np.vstack(X_list)\n",
    "    y = np.hstack(y_list)\n",
    "    groups = np.array(groups)\n",
    "    \n",
    "    print(f\"Training data shape: X={X.shape}, y={y.shape}\")\n",
    "    print(f\"Number of wells: {len(well_info)}\")\n",
    "    print(f\"Total samples: {len(y)}\")\n",
    "    \n",
    "    return X, y, groups, well_info, features.columns.tolist()\n",
    "\n",
    "# Build training data (using all wells; in practice may sample for faster iteration)\n",
    "print(\"Building training data...\")\n",
    "X_train, y_train, groups_train, well_info, feature_names = build_training_data(train_wells_data, sample_fraction=0.5)\n",
    "print(f\"\\nFeature names (first 20): {feature_names[:20]}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Section 9: Residual ML Models\n",
    "### Train ML models on (y_true - y_baseline)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def train_residual_learners(X, y, groups, feature_names):\n",
    "    \"\"\"\n",
    "    Train CatBoost and LightGBM on residuals.\n",
    "    Returns: trained models and residual statistics.\n",
    "    \"\"\"\n",
    "    \n",
    "    # Extract baseline predictions from features\n",
    "    baseline_cols = [i for i, name in enumerate(feature_names) if 'base_baseline_TVT' in name]\n",
    "    if baseline_cols:\n",
    "        y_baseline = X[:, baseline_cols[0]]\n",
    "    else:\n",
    "        y_baseline = np.zeros_like(y)\n",
    "    \n",
    "    residuals = y - y_baseline\n",
    "    print(f\"Residuals: mean={residuals.mean():.4f}, std={residuals.std():.4f}\")\n",
    "    print(f\"Baseline RMSE: {np.sqrt(np.mean(y_baseline ** 2)):.4f}\")\n",
    "    print(f\"Residual RMSE: {np.sqrt(np.mean(residuals ** 2)):.4f}\")\n",
    "    \n",
    "    models = {}\n",
    "    cv_scores = {}\n",
    "    \n",
    "    # Prepare data\n",
    "    scaler = StandardScaler()\n",
    "    X_scaled = scaler.fit_transform(X)\n",
    "    \n",
    "    gkf = GroupKFold(n_splits=5)\n",
    "    \n",
    "    # CatBoost\n",
    "    if HAS_CATBOOST:\n",
    "        print(\"\\n=== Training CatBoost ===\")\n",
    "        cb_model = cb.CatBoostRegressor(\n",
    "            iterations=500,\n",
    "            depth=6,\n",
    "            learning_rate=0.05,\n",
    "            loss_function='RMSE',\n",
    "            verbose=100,\n",
    "            random_state=42,\n",
    "            thread_count=-1,\n",
    "        )\n",
    "        \n",
    "        fold_scores = []\n",
    "        for train_idx, val_idx in gkf.split(X, y, groups):\n",
    "            X_fold_train, X_fold_val = X_scaled[train_idx], X_scaled[val_idx]\n",
    "            y_fold_train, y_fold_val = residuals[train_idx], residuals[val_idx]\n",
    "            \n",
    "            cb_model.fit(X_fold_train, y_fold_train, verbose=0)\n",
    "            y_pred = cb_model.predict(X_fold_val)\n",
    "            rmse = np.sqrt(mean_squared_error(y_fold_val, y_pred))\n",
    "            fold_scores.append(rmse)\n",
    "        \n",
    "        cv_scores['CatBoost'] = fold_scores\n",
    "        print(f\"CatBoost CV RMSE: mean={np.mean(fold_scores):.4f}, std={np.std(fold_scores):.4f}\")\n",
    "        \n",
    "        # Train on all data\n",
    "        cb_model.fit(X_scaled, residuals, verbose=0)\n",
    "        models['CatBoost'] = (cb_model, scaler)\n",
    "    \n",
    "    # LightGBM\n",
    "    if HAS_LGBM:\n",
    "        print(\"\\n=== Training LightGBM ===\")\n",
    "        lgb_model = lgb.LGBMRegressor(\n",
    "            n_estimators=500,\n",
    "            max_depth=8,\n",
    "            learning_rate=0.05,\n",
    "            verbose=-1,\n",
    "            random_state=42,\n",
    "            n_jobs=-1,\n",
    "        )\n",
    "        \n",
    "        fold_scores = []\n",
    "        for train_idx, val_idx in gkf.split(X, y, groups):\n",
    "            X_fold_train, X_fold_val = X_scaled[train_idx], X_scaled[val_idx]\n",
    "            y_fold_train, y_fold_val = residuals[train_idx], residuals[val_idx]\n",
    "            \n",
    "            lgb_model.fit(X_fold_train, y_fold_train)\n",
    "            y_pred = lgb_model.predict(X_fold_val)\n",
    "            rmse = np.sqrt(mean_squared_error(y_fold_val, y_pred))\n",
    "            fold_scores.append(rmse)\n",
    "        \n",
    "        cv_scores['LightGBM'] = fold_scores\n",
    "        print(f\"LightGBM CV RMSE: mean={np.mean(fold_scores):.4f}, std={np.std(fold_scores):.4f}\")\n",
    "        \n",
    "        # Train on all data\n",
    "        lgb_model.fit(X_scaled, residuals)\n",
    "        models['LightGBM'] = (lgb_model, scaler)\n",
    "    \n",
    "    return models, cv_scores, y_baseline, residuals\n",
    "\n",
    "print(\"Training residual learners (this may take a few minutes)...\")\n",
    "models, cv_scores, y_baseline, residuals = train_residual_learners(X_train, y_train, groups_train, feature_names)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Section 10: Cross-Validation & Performance Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def evaluate_ensemble(X, y, groups, models, feature_names, y_baseline, y_residuals, model_name='Ensemble'):\n",
    "    \"\"\"\n",
    "    Evaluate ensemble of baseline + ML models using GroupKFold.\n",
    "    \"\"\"\n",
    "    gkf = GroupKFold(n_splits=5)\n",
    "    \n",
    "    baseline_rmse_folds = []\n",
    "    ensemble_rmse_folds = []\n",
    "    ml_rmse_folds = []\n",
    "    \n",
    "    for train_idx, val_idx in gkf.split(X, y, groups):\n",
    "        y_val = y[val_idx]\n",
    "        y_base_val = y_baseline[val_idx]\n",
    "        \n",
    "        # Baseline RMSE\n",
    "        base_rmse = np.sqrt(mean_squared_error(y_val, y_base_val))\n",
    "        baseline_rmse_folds.append(base_rmse)\n",
    "        \n",
    "        # ML predictions on validation set\n",
    "        if models:\n",
    "            X_val = X[val_idx]\n",
    "            model_name_list = list(models.keys())\n",
    "            \n",
    "            ml_preds = []\n",
    "            for model_key in model_name_list:\n",
    "                model_obj, scaler = models[model_key]\n",
    "                X_val_scaled = scaler.transform(X_val)\n",
    "                pred = model_obj.predict(X_val_scaled)\n",
    "                ml_preds.append(pred)\n",
    "            \n",
    "            # Average ML predictions\n",
    "            ml_pred_avg = np.mean(ml_preds, axis=0)\n",
    "            \n",
    "            # Ensemble = baseline + ML residual correction\n",
    "            y_ensemble = y_base_val + ml_pred_avg\n",
    "            \n",
    "            ensemble_rmse = np.sqrt(mean_squared_error(y_val, y_ensemble))\n",
    "            ensemble_rmse_folds.append(ensemble_rmse)\n",
    "            \n",
    "            ml_rmse = np.sqrt(mean_squared_error(y_residuals[val_idx], ml_pred_avg))\n",
    "            ml_rmse_folds.append(ml_rmse)\n",
    "    \n",
    "    print(f\"\\n=== {model_name} CV Results ===\")\n",
    "    print(f\"Baseline RMSE: {np.mean(baseline_rmse_folds):.4f} (+/- {np.std(baseline_rmse_folds):.4f})\")\n",
    "    if ensemble_rmse_folds:\n",
    "        print(f\"ML Residual RMSE: {np.mean(ml_rmse_folds):.4f} (+/- {np.std(ml_rmse_folds):.4f})\")\n",
    "        print(f\"Ensemble RMSE: {np.mean(ensemble_rmse_folds):.4f} (+/- {np.std(ensemble_rmse_folds):.4f})\")\n",
    "        print(f\"Improvement: {np.mean(baseline_rmse_folds) - np.mean(ensemble_rmse_folds):.4f} ft\")\n",
    "    \n",
    "    return {\n",
    "        'baseline': baseline_rmse_folds,\n",
    "        'ml_residual': ml_rmse_folds if ml_rmse_folds else None,\n",
    "        'ensemble': ensemble_rmse_folds if ensemble_rmse_folds else None,\n",
    "    }\n",
    "\n",
    "cv_results = evaluate_ensemble(X_train, y_train, groups_train, models, feature_names, y_baseline, residuals)"
   ]
  },
  {
   "cell_type": "markdown",
