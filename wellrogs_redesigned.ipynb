{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Rogii Wellbore Geology — Geology-Aware Redesign\n",
    "## Target: RMSE < 6 via Geological Intelligence + Residual ML\n",
    "\n",
    "**Architecture:** Geological baseline → Feature engineering → ML residual learning → Ensemble\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "from pathlib import Path\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "from sklearn.model_selection import GroupKFold\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "from sklearn.metrics import mean_squared_error\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "try:\n",
    "    import catboost as cb\n",
    "    HAS_CATBOOST = True\n",
    "except:\n",
    "    HAS_CATBOOST = False\n",
    "    print('CatBoost not available')\n",
    "\n",
    "try:\n",
    "    import lightgbm as lgb\n",
    "    HAS_LGBM = True\n",
    "except:\n",
    "    HAS_LGBM = False\n",
    "    print('LightGBM not available')\n",
    "\n",
    "BASE_PATH = Path('/kaggle/input/competitions/rogii-wellbore-geology-prediction')\n",
    "TRAIN_PATH = BASE_PATH / 'train'\n",
    "TEST_PATH = BASE_PATH / 'test'\n",
    "\n",
    "train_hw_files = sorted(TRAIN_PATH.glob('*__horizontal_well.csv'))\n",
    "test_hw_files = sorted(TEST_PATH.glob('*__horizontal_well.csv'))\n",
    "\n",
    "print(f'Train wells: {len(train_hw_files)}')\n",
    "print(f'Test wells: {len(test_hw_files)}')\n",
    "print(f'CatBoost available: {HAS_CATBOOST}')\n",
    "print(f'LightGBM available: {HAS_LGBM}')\n",
    "\n",
    "rng = np.random.RandomState(42)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Load Well Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def load_well(hw_path, tw_path=None):\n",
    "    hw = pd.read_csv(hw_path)\n",
    "    tw = None\n",
    "    if tw_path and tw_path.exists():\n",
    "        try:\n",
    "            tw = pd.read_csv(tw_path)\n",
    "        except:\n",
    "            pass\n",
    "    return hw, tw\n",
    "\n",
    "def get_well_id(path):\n",
    "    return path.stem.split('__')[0]\n",
    "\n",
    "train_wells = []\n",
    "for hw_path in train_hw_files[:10]:  # Sample 10 wells for speed\n",
    "    well_id = get_well_id(hw_path)\n",
    "    tw_path = TRAIN_PATH / f'{well_id}__typewell.csv'\n",
    "    hw, tw = load_well(hw_path, tw_path)\n",
    "    train_wells.append({'well_id': well_id, 'hw': hw, 'tw': tw})\n",
    "\n",
    "print(f'Loaded {len(train_wells)} training wells')\n",
    "print(f'Sample well shape: {train_wells[0][\"hw\"].shape}')\n",
    "print(f'Columns: {list(train_wells[0][\"hw\"].columns)}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Geological Surface Features"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def create_geo_features(hw):\n",
    "    features = pd.DataFrame(index=hw.index)\n",
    "    \n",
    "    surfaces = ['ANCC', 'ASTNU', 'ASTNL', 'EGFDU', 'EGFDL', 'BUDA']\n",
    "    for surf in surfaces:\n",
    "        if surf in hw.columns:\n",
    "            features[f'Z_{surf}'] = hw['Z'] - hw[surf]\n",
    "    \n",
    "    thickness_pairs = [\n",
    "        ('ANCC', 'ASTNU'),\n",
    "        ('ASTNU', 'ASTNL'),\n",
    "        ('ASTNL', 'EGFDU'),\n",
    "        ('EGFDU', 'EGFDL'),\n",
    "        ('EGFDL', 'BUDA'),\n",
    "    ]\n",
    "    for s1, s2 in thickness_pairs:\n",
    "        if s1 in hw.columns and s2 in hw.columns:\n",
    "            features[f'{s1}_{s2}'] = hw[s1] - hw[s2]\n",
    "    \n",
    "    return features.fillna(0)\n",
    "\n",
    "sample_geo = create_geo_features(train_wells[0]['hw'])\n",
    "print(f'Geological features: {sample_geo.shape[1]} features')\n",
    "print(f'Sample: {list(sample_geo.columns[:5])}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. GR Multi-Scale Features"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def create_gr_features(hw):\n",
    "    features = pd.DataFrame(index=hw.index)\n",
    "    \n",
    "    if 'GR' not in hw.columns:\n",
    "        return features\n",
    "    \n",
    "    gr = np.nan_to_num(hw['GR'].values, 0)\n",
    "    gr_series = pd.Series(gr, index=hw.index)\n",
    "    \n",
    "    for window in [50, 100, 200]:\n",
    "        if len(gr) >= window:\n",
    "            features[f'GR_mean_w{window}'] = gr_series.rolling(window=window, center=True).mean().values\n",
    "            features[f'GR_std_w{window}'] = gr_series.rolling(window=window, center=True).std().values\n",
    "    \n",
    "    grad = np.gradient(gr)\n",
    "    features['GR_gradient'] = grad\n",
    "    features['GR_abs_gradient'] = np.abs(grad)\n",
    "    \n",
    "    return features.fillna(0)\n",
    "\n",
    "sample_gr = create_gr_features(train_wells[0]['hw'])\n",
    "print(f'GR features: {sample_gr.shape[1]} features')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. TVT Trajectory Pattern Features"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def extract_tvt_patterns(hw):\n",
    "    patterns = {}\n",
    "    \n",
    "    known_mask = hw['TVT_input'].notna()\n",
    "    if known_mask.sum() < 10:\n",
    "        return patterns\n",
    "    \n",
    "    known = hw[known_mask].copy()\n",
    "    tvt = known['TVT_input'].values\n",
    "    md = known['MD'].values\n",
    "    \n",
    "    dtvt = np.diff(tvt)\n",
    "    patterns['dTVT_mean'] = np.mean(dtvt)\n",
    "    patterns['dTVT_std'] = np.std(dtvt)\n",
    "    patterns['dTVT_median'] = np.median(dtvt)\n",
    "    \n",
    "    poly = np.polyfit(md, tvt, 1)\n",
    "    patterns['TVT_slope_full'] = poly[0]\n",
    "    patterns['TVT_intercept_full'] = poly[1]\n",
    "    \n",
    "    if len(known) >= 500:\n",
    "        last500 = known.tail(500)\n",
    "        poly500 = np.polyfit(last500['MD'].values, last500['TVT_input'].values, 1)\n",
    "        patterns['TVT_slope_500'] = poly500[0]\n",
    "    else:\n",
    "        patterns['TVT_slope_500'] = patterns['TVT_slope_full']\n",
    "    \n",
    "    patterns['TVT_anchor'] = tvt[-1]\n",
    "    patterns['MD_anchor'] = md[-1]\n",
    "    patterns['known_length'] = len(known)\n",
    "    \n",
    "    return patterns\n",
    "\n",
    "sample_patterns = extract_tvt_patterns(train_wells[0]['hw'])\n",
    "print(f'TVT patterns extracted: {len(sample_patterns)} features')\n",
    "for k, v in list(sample_patterns.items())[:3]:\n",
    "    print(f'  {k}: {v:.4f}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Prediction Start (PS) Features"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def create_ps_features(hw):\n",
    "    features = pd.DataFrame(index=hw.index)\n",
    "    \n",
    "    known_mask = hw['TVT_input'].notna()\n",
    "    ps_md = hw.loc[known_mask, 'MD'].iloc[-1] if known_mask.sum() > 0 else hw['MD'].iloc[0]\n",
    "    \n",
    "    features['is_after_PS'] = (~known_mask).astype(int)\n",
    "    features['md_from_PS'] = (hw['MD'] - ps_md).clip(lower=0)\n",
    "    features['rows_after_PS'] = (np.arange(len(hw)) - known_mask.sum()).clip(lower=0)\n",
    "    \n",
    "    return features.fillna(0)\n",
    "\n",
    "sample_ps = create_ps_features(train_wells[0]['hw'])\n",
    "print(f'PS features: {sample_ps.shape[1]} features')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Baseline Geological Prediction"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def predict_baseline_tvt(hw, patterns):\n",
    "    eval_mask = hw['TVT_input'].isna()\n",
    "    if not eval_mask.any():\n",
    "        return None\n",
    "    \n",
    "    eval_hw = hw[eval_mask].copy()\n",
    "    \n",
    "    anchor = patterns.get('TVT_anchor', 0)\n",
    "    ps_md = patterns.get('MD_anchor', 0)\n",
    "    slope_full = patterns.get('TVT_slope_full', 0)\n",
    "    slope_500 = patterns.get('TVT_slope_500', 0)\n",
    "    \n",
    "    md_offset = eval_hw['MD'].values - ps_md\n",
    "    \n",
    "    pred_flat = np.full(len(eval_hw), anchor)\n",
    "    pred_slope_full = anchor + slope_full * md_offset\n",
    "    pred_slope_500 = anchor + slope_500 * md_offset\n",
    "    \n",
    "    baseline = (pred_flat + pred_slope_full + pred_slope_500) / 3\n",
    "    \n",
    "    return pd.DataFrame({\n",
    "        'baseline_TVT': baseline,\n",
    "        'pred_flat': pred_flat,\n",
    "        'pred_slope_full': pred_slope_full,\n",
    "    }, index=eval_hw.index)\n",
    "\n",
    "sample_baseline = predict_baseline_tvt(train_wells[0]['hw'], sample_patterns)\n",
    "if sample_baseline is not None:\n",
    "    print(f'Baseline predictions: {sample_baseline.shape}')\n",
    "    print(f'Mean baseline TVT: {sample_baseline[\"baseline_TVT\"].mean():.2f} ft')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Comprehensive Feature Matrix"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def build_feature_matrix(hw, tw=None, patterns=None, baseline=None):\n",
    "    eval_mask = hw['TVT_input'].isna()\n",
    "    eval_hw = hw[eval_mask].copy()\n",
    "    \n",
    "    if len(eval_hw) == 0:\n",
    "        return None\n",
    "    \n",
    "    X = pd.DataFrame(index=eval_hw.index)\n",
    "    \n",
    "    geo_feat = create_geo_features(eval_hw)\n",
    "    for col in geo_feat.columns:\n",
    "        X[col] = geo_feat[col]\n",
    "    \n",
    "    gr_feat = create_gr_features(eval_hw)\n",
    "    for col in gr_feat.columns:\n",
    "        X[col] = gr_feat[col]\n",
    "    \n",
    "    ps_feat = create_ps_features(eval_hw)\n",
    "    for col in ps_feat.columns:\n",
    "        X[col] = ps_feat[col]\n",
    "    \n",
    "    if patterns:\n",
    "        for key, val in patterns.items():\n",
    "            X[f'pattern_{key}'] = val\n",
    "    \n",
    "    if baseline is not None:\n",
    "        for col in baseline.columns:\n",
    "            X[f'base_{col}'] = baseline[col].values\n",
    "    \n",
    "    if 'X' in eval_hw.columns:\n",
    "        X['X'] = eval_hw['X'].values\n",
    "    if 'Y' in eval_hw.columns:\n",
    "        X['Y'] = eval_hw['Y'].values\n",
    "    if 'Z' in eval_hw.columns:\n",
    "        X['Z'] = eval_hw['Z'].values\n",
    "    if 'MD' in eval_hw.columns:\n",
    "        X['MD'] = eval_hw['MD'].values\n",
    "    \n",
    "    return X.fillna(0)\n",
    "\n",
    "sample_X = build_feature_matrix(train_wells[0]['hw'], train_wells[0]['tw'], sample_patterns, sample_baseline)\n",
    "print(f'Feature matrix: {sample_X.shape}')\n",
    "print(f'Total features: {len(sample_X.columns)}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 8. Build Training Data with GroupKFold"
   ]
  },
  {
   "cell_type": {"cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def build_training_data(wells_list):\n",
    "    X_list = []\n",
    "    y_list = []\n",
    "    groups = []\n",
    "    \n",
    "    for well_data in wells_list:\n",
    "        well_id = well_data['well_id']\n",
    "        hw = well_data['hw']\n",
    "        tw = well_data['tw']\n",
    "        \n",
    "        eval_mask = hw['TVT_input'].isna()\n",
    "        if not eval_mask.any() or 'TVT' not in hw.columns:\n",
    "            continue\n",
    "        \n",
    "        eval_hw = hw[eval_mask].copy()\n",
    "        \n",
    "        patterns = extract_tvt_patterns(hw)\n",
    "        baseline = predict_baseline_tvt(hw, patterns)\n",
    "        X = build_feature_matrix(hw, tw, patterns, baseline)\n",
    "        \n",
    "        if X is None or len(X) == 0:\n",
    "            continue\n",
    "        \n",
    "        y = eval_hw['TVT'].values\n",
    "        if len(X) != len(y):\n",
    "            continue\n",
    "        \n",
    "        X_list.append(X.values)\n",
    "        y_list.append(y)\n",
    "        groups.extend([well_id] * len(y))\n",
    "    \n",
    "    X = np.vstack(X_list)\n",
    "    y = np.hstack(y_list)\n",
    "    groups = np.array(groups)\n",
    "    \n",
    "    print(f'Training data: X shape {X.shape}, y shape {y.shape}')\n",
    "    print(f'Unique wells: {len(np.unique(groups))}')\n",
    "    \n",
    "    return X, y, groups, X.shape[1]\n",
    "\n",
    "X_train, y_train, groups_train, n_features = build_training_data(train_wells)\n",
    "print(f'Features: {n_features}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 9. Extract Baseline Predictions"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "y_baseline = X_train[:, -3]\n",
    "residuals = y_train - y_baseline\n",
    "\n",
    "baseline_rmse = np.sqrt(np.mean(y_baseline ** 2))\n",
    "residual_rmse = np.sqrt(np.mean(residuals ** 2))\n",
    "\n",
    "print(f'Baseline RMSE: {baseline_rmse:.4f} ft')\n",
    "print(f'Residual RMSE: {residual_rmse:.4f} ft')\n",
    "print(f'Residual stats: mean={residuals.mean():.4f}, std={residuals.std():.4f}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 10. Train Residual ML Models"
   ]
  },
  {
   "cell_type": {"cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "scaler = StandardScaler()\n",
    "X_scaled = scaler.fit_transform(X_train)\n",
    "\n",
    "gkf = GroupKFold(n_splits=5)\n",
    "baseline_rmse_folds = []\n",
    "ensemble_rmse_folds = []\n",
    "ml_preds_list = []\n",
    "\n",
    "print('Running GroupKFold cross-validation...')\n",
    "\n",
    "for fold, (train_idx, val_idx) in enumerate(gkf.split(X_train, y_train, groups_train)):\n",
    "    X_fold_train, X_fold_val = X_scaled[train_idx], X_scaled[val_idx]\n",
    "    y_fold_train, y_fold_val = y_train[train_idx], y_train[val_idx]\n",
    "    y_baseline_val = y_baseline[val_idx]\n",
    "    residuals_fold_train = y_fold_train - y_baseline[train_idx]\n",
    "    \n",
    "    base_rmse = np.sqrt(mean_squared_error(y_fold_val, y_baseline_val))\n",
    "    baseline_rmse_folds.append(base_rmse)\n",
    "    \n",
    "    ml_preds_fold = []\n",
    "    \n",
    "    if HAS_CATBOOST:\n",
    "        cb_model = cb.CatBoostRegressor(iterations=300, depth=5, learning_rate=0.05, verbose=0, random_state=42)\n",
    "        cb_model.fit(X_fold_train, residuals_fold_train, verbose=0)\n",
    "        pred = cb_model.predict(X_fold_val)\n",
    "        ml_preds_fold.append(pred)\n",
    "    \n",
    "    if HAS_LGBM:\n",
    "        lgb_model = lgb.LGBMRegressor(n_estimators=300, max_depth=7, learning_rate=0.05, verbose=-1, random_state=42)\n",
    "        lgb_model.fit(X_fold_train, residuals_fold_train)\n",
    "        pred = lgb_model.predict(X_fold_val)\n",
    "        ml_preds_fold.append(pred)\n",
    "    \n",
    "    if ml_preds_fold:\n",
    "        ml_avg = np.mean(ml_preds_fold, axis=0)\n",
    "        y_ensemble = y_baseline_val + ml_avg\n",
    "        ens_rmse = np.sqrt(mean_squared_error(y_fold_val, y_ensemble))\n",
    "        ensemble_rmse_folds.append(ens_rmse)\n",
    "        ml_preds_list.append(ml_avg)\n",
    "    \n",
    "    print(f'Fold {fold+1}: Baseline={base_rmse:.4f}, Ensemble={ens_rmse:.4f}')\n",
    "\n",
    "print(f'\\nMean Baseline RMSE: {np.mean(baseline_rmse_folds):.4f} ft')\n",
    "if ensemble_rmse_folds:\n",
    "    print(f'Mean Ensemble RMSE: {np.mean(ensemble_rmse_folds):.4f} ft')\n",
    "    print(f'Improvement: {np.mean(baseline_rmse_folds) - np.mean(ensemble_rmse_folds):.4f} ft')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 11. Visualization"
   ]
  },
  {
   "cell_type": {"cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "fig, axes = plt.subplots(2, 2, figsize=(14, 10))\n",
    "\n",
    "ax = axes[0, 0]\n",
    "x_pos = [0, 1]\n",
    "means = [np.mean(baseline_rmse_folds), np.mean(ensemble_rmse_folds) if ensemble_rmse_folds else 0]\n",
    "stds = [np.std(baseline_rmse_folds), np.std(ensemble_rmse_folds) if ensemble_rmse_folds else 0]\n",
    "ax.bar(x_pos, means, yerr=stds, capsize=5, alpha=0.7, color=['orange', 'green'])\n",
    "ax.set_xticks(x_pos)\n",
    "ax.set_xticklabels(['Baseline', 'Ensemble'])\n",
    "ax.set_ylabel('RMSE (ft)')\n",
    "ax.set_title('Baseline vs Ensemble')\n",
    "ax.grid(axis='y', alpha=0.3)\n",
    "\n",
    "ax = axes[0, 1]\n",
    "ax.hist(residuals, bins=100, alpha=0.7, edgecolor='black')\n",
    "ax.set_xlabel('Residual (ft)')\n",
    "ax.set_ylabel('Frequency')\n",
    "ax.set_title('Residual Distribution')\n",
    "ax.grid(alpha=0.3)\n",
    "\n",
    "ax = axes[1, 0]\n",
    "ax.scatter(y_baseline, y_train, alpha=0.2, s=1)\n",
    "min_val = min(y_baseline.min(), y_train.min())\n",
    "max_val = max(y_baseline.max(), y_train.max())\n",
    "ax.plot([min_val, max_val], [min_val, max_val], 'r--', lw=2)\n",
    "ax.set_xlabel('Baseline Prediction (ft)')\n",
    "ax.set_ylabel('Ground Truth (ft)')\n",
    "ax.set_title('Baseline Prediction Accuracy')\n",
    "ax.grid(alpha=0.3)\n",
    "\n",
    "ax = axes[1, 1]\n",
    "folds = np.arange(1, len(baseline_rmse_folds) + 1)\n",
    "ax.plot(folds, baseline_rmse_folds, 'o-', label='Baseline', linewidth=2, markersize=8)\n",
    "if ensemble_rmse_folds:\n",
    "    ax.plot(folds, ensemble_rmse_folds, 's-', label='Ensemble', linewidth=2, markersize=8)\n",
    "ax.set_xlabel('Fold')\n",
    "ax.set_ylabel('RMSE (ft)')\n",
    "ax.set_title('Per-Fold Performance')\n",
    "ax.legend()\n",
    "ax.grid(alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "print('Visualization complete')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 12. Summary"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print('\\n' + '='*80)\n",
