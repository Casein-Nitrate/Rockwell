    "def predict_test_well(hw, tw, models, feature_names, scaler_for_features):\n",
    "    \"\"\"\n",
    "    Make predictions on test well (with unknown TVT in eval zone).\n",
    "    \"\"\"\n",
    "    # Extract patterns and baseline\n",
    "    tvt_patterns = extract_tvt_patterns(hw)\n",
    "    baseline_pred = predict_baseline_tvt(hw, tvt_patterns)\n",
    "    \n",
    "    # Build features\n",
    "    features = build_feature_matrix(hw, tw, tvt_patterns, baseline_pred)\n",
    "    if features is None or len(features) == 0:\n",
    "        return None\n",
    "    \n",
    "    # Get baseline prediction\n",
    "    baseline_cols = [i for i, name in enumerate(feature_names) if 'base_baseline_TVT' in name]\n",
    "    if baseline_cols:\n",
    "        y_baseline = features.values[:, baseline_cols[0]]\n",
    "    else:\n",
    "        y_baseline = np.zeros(len(features))\n",
    "    \n",
    "    # ML correction\n",
    "    ml_corrections = []\n",
    "    for model_key, (model_obj, scaler) in models.items():\n",
    "        X_scaled = scaler.transform(features.values)\n",
    "        correction = model_obj.predict(X_scaled)\n",
    "        ml_corrections.append(correction)\n",
    "    \n",
    "    # Average corrections\n",
    "    avg_correction = np.mean(ml_corrections, axis=0) if ml_corrections else np.zeros_like(y_baseline)\n",
    "    \n",
    "    # Final prediction\n",
    "    y_pred = y_baseline + avg_correction\n",
    "    \n",
    "    return y_pred\n",
    "\n",
    "# Load test wells and make predictions\n",
    "test_predictions = {}\n",
    "for hw_path in test_hw_files[:1]:  # Demo: predict first test well\n",
    "    well_id = get_well_id(hw_path)\n",
    "    tw_path = TEST_PATH / f'{well_id}__typewell.csv'\n",
    "    hw, tw = load_well_data(hw_path, tw_path)\n",
    "    \n",
    "    pred = predict_test_well(hw, tw, models, feature_names, None)\n",
    "    if pred is not None:\n",
    "        test_predictions[well_id] = pred\n",
    "        print(f\"Test well {well_id}: predicted {len(pred)} TVT values\")\n",
    "        print(f\"  Mean TVT: {pred.mean():.2f} ft\")\n",
    "        print(f\"  Range: [{pred.min():.2f}, {pred.max():.2f}] ft\")"}}
  },
